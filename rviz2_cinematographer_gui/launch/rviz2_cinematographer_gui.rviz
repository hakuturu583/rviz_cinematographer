Panels:
  - Class: rviz_common/Displays
    Help Height: 84
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.4271099865436554
    Tree Height: 701
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
